   <Iptc4xmpCore:AltTextAccessibility>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Map shows route 34 crossing the park from Estes Park in the east to Grand Lake in the west. Three visitor centers are located along route 34. Three more are located on the east side of the park. Additional facilities like campgrounds, picnic areas and trails are also shown.</rdf:li>
    </rdf:Alt>
   </Iptc4xmpCore:AltTextAccessibility>
